# Bắt buộc nếu muốn giữ phiên đăng nhập sau khi khởi động lại server (chuỗi ngẫu nhiên >= 32 ký tự):
CHAM_SESSION_SECRET=

# UID tài khoản Locket duy nhất được phép dùng chỉnh ảnh AI (xem & sao chép tại mục Tài khoản):
CHAM_AI_OWNER_UID=

# --- Cách 1: Cloudflare Workers AI (Miễn phí mỗi ngày, không cần thẻ ngân hàng) ---
# Để trống CHAM_AI_PROVIDER sẽ tự ưu tiên Cloudflare nếu có đủ Account ID & Token:
CHAM_AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# --- Cách 2: Google Gemini (Cần bật Billing / Tier 1 trên Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
